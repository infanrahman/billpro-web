NEXT_PUBLIC_BILLING_TRACKING_URL=http://127.0.0.1:3000

# Set this in Vercel to use the Railway Django API as the source of truth.
# Leave empty for the local Next.js storage fallback.
NEXT_PUBLIC_BILLING_API_URL=https://billpro-web-production.up.railway.app/api

# SQLite database location. Use an absolute path in production if the working
# directory may change between deploys.
BILLING_TRACKING_SQLITE_PATH=./.data/tracking.sqlite
BILLING_TRACKING_LEGACY_JSON_PATH=./.data/tracking-db.json

# Optional persistent Neon/PostgreSQL connection. When set, this takes
# precedence over SQLite and creates the tracking tables automatically.
BILLING_TRACKING_DATABASE_URL=

# Bootstrap login is enabled automatically in development.
# In production, set this to true only for first setup, then disable it.
BILLING_TRACKING_BOOTSTRAP_ENABLED=false
BILLING_TRACKING_BOOTSTRAP_OWNER_PASSWORD=change-this-owner-password
BILLING_TRACKING_BOOTSTRAP_MANAGER_PASSWORD=change-this-manager-password

# Vercel note:
# SQLite is for local testing only. On Vercel, the app defaults to ephemeral
# /tmp storage for smoke tests. For real data, add a hosted database such as
# Vercel Postgres/Neon/Supabase and migrate repository storage.
