NEXT_PUBLIC_BILLING_TRACKING_URL=http://127.0.0.1:3000

# SQLite database location. Use an absolute path in production if the working
# directory may change between deploys.
BILLING_TRACKING_SQLITE_PATH=./.data/tracking.sqlite
BILLING_TRACKING_LEGACY_JSON_PATH=./.data/tracking-db.json

# Bootstrap login is enabled automatically in development.
# In production, set this to true only for first setup, then disable it.
BILLING_TRACKING_BOOTSTRAP_ENABLED=false
BILLING_TRACKING_BOOTSTRAP_OWNER_PASSWORD=change-this-owner-password
BILLING_TRACKING_BOOTSTRAP_MANAGER_PASSWORD=change-this-manager-password
